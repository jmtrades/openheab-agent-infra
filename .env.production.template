# ============================================================================
# OpenHeab production env — fill the TODOs, save as .env.production
# ============================================================================

# Required
DATABASE_URL=postgres://YOUR_USER:YOUR_PASS@YOUR_HOST.neon.tech/openheab?sslmode=require
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_PRO_MONTHLY=price_REPLACE_ME

# Master keys — generate fresh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IDENTITY_MASTER_KEK=REPLACE_ME_64_HEX_CHARS
CRYPTO_MASTER_KEK=REPLACE_ME_64_HEX_CHARS
SECRETS_MASTER_KEK=REPLACE_ME_64_HEX_CHARS
BANK_MASTER_KEK=REPLACE_ME_64_HEX_CHARS

OPERATOR_PUBLIC_URL=https://openheab.com

# At least one inference provider key
OPENAI_API_KEY=sk-REPLACE_ME
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Cron + admin
CRON_SECRET=REPLACE_ME_RANDOM
ADMIN_API_TOKEN=REPLACE_ME_RANDOM
OPERATOR_ADMIN_TOKEN=REPLACE_ME_RANDOM
WEBHOOK_SIGNING_SECRET=REPLACE_ME_RANDOM

# Optional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
HCAPTCHA_SECRET=
FEE_SPLITTER_ADDRESS=
PLATFORM_TREASURY_ADDRESS=
OPENHEAB_PLATFORM_DID=

# Inference markup (basis points) — 1000 = 10%
INFERENCE_MARKUP_BPS=1000

# Identity signup throttle
IDENTITY_SIGNUP_LIMIT_PER_HOUR=10
