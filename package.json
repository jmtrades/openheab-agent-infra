{
  "name": "openheab-substrate",
  "version": "0.2.0",
  "description": "Agent-native infrastructure substrate — 228 production primitives across 39 layers (identity, USDC bank on Base, KYC, cards, lending, multi-provider LLM inference, sandboxes, browsers, voice/vision/video, planning/simulation, DAOs, entities, contracts, courts, IP registry, brokerage, prediction markets, AGI passport, RLAF, audit chain). 145+ MCP tools. Sold to AI agents.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "migrate": "node -e \"require('dotenv').config(); const {Pool}=require('pg'); const {migrateAll}=require('./src/integration'); const p=new Pool({connectionString:process.env.DATABASE_URL,ssl:process.env.DATABASE_URL.includes('sslmode=require')?{rejectUnauthorized:false}:undefined}); migrateAll(p).then(()=>{console.log('done');process.exit(0)}).catch(e=>{console.error(e);process.exit(1)})\"",
    "test": "node test/unit.js && node test/boot.js && node test/bank_lifecycle.js && node test/e2e.js && node test/route_smoke.js",
    "test:unit": "node test/unit.js",
    "test:boot": "node test/boot.js",
    "test:bank": "node test/bank_lifecycle.js",
    "test:e2e": "node test/e2e.js",
    "test:smoke": "node test/route_smoke.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "js-sha3": "^0.9.3",
    "keccak": "^3.0.4",
    "pg": "^8.12.0",
    "stripe": "^15.12.0",
    "twilio": "^5.3.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "pg-mem": "^3.0.4"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmtrades/openheab-agent-infra.git"
  },
  "keywords": [
    "ai-agents",
    "agent-infrastructure",
    "did",
    "ed25519",
    "audit-chain",
    "openheab",
    "mcp",
    "usdc",
    "stablecoin"
  ]
}
