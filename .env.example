# ============================================================================
# OpenHeab Substrate — environment variable manifest (189 primitives, 30 layers)
#
# Boot in stub mode with only the REQUIRED block set. Everything else is
# optional — primitives auto-detect missing env vars and fall back to stub
# behaviour. See /v1/admin/providers (with x-admin-token) for the live
# status of all 32 external providers.
#
# Generate cryptographic keys with: openssl rand -hex 32
# Or run the substrate then visit /v1/setup/generate-keks for fresh values.
# ============================================================================

# ============================================================================
# REQUIRED — 5 variables. Substrate refuses to boot without these.
# ============================================================================
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require
IDENTITY_MASTER_KEK=GENERATE_ME_64_HEX_CHARS
CRYPTO_MASTER_KEK=GENERATE_ME_64_HEX_CHARS
OPERATOR_PUBLIC_URL=https://openheab.com
OPERATOR_ADMIN_TOKEN=GENERATE_ME_RANDOM_STRING

# ============================================================================
# INFERENCE — set at least one (or use in-house stub for testing)
# ============================================================================
INFERENCE_CORE_BACKEND_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
MISTRAL_API_KEY=

# ============================================================================
# IN-HOUSE CORES — replace third-party APIs with our own implementations
# ============================================================================
BANK_MASTER_KEK=GENERATE_ME_64_HEX_CHARS
CARD_CORE_MASTER_KEK=GENERATE_ME_64_HEX_CHARS
CARD_CORE_NETWORK_SECRET=GENERATE_ME_RANDOM_STRING
ACH_MASTER_KEK=GENERATE_ME_64_HEX_CHARS
EMAIL_CORE_MTA_SECRET=GENERATE_ME_RANDOM_STRING
INTEGRATIONS_MASTER_KEK=GENERATE_ME_64_HEX_CHARS
OPERATOR_ROOT_PRIVATE_KEY_PEM=
OPENHEAB_BIN_RANGE=477489
BANK_CORE_RESERVE_RATIO_BPS=10000
TRAVEL_RULE_THRESHOLD_CENTS=100000

# ============================================================================
# STRIPE (subscriptions + checkout + signup flow)
# ============================================================================
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_PRO_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=

# ============================================================================
# OPTIONAL — features auto-disable if missing
# ============================================================================
TWILIO_ACCOUNT_SID=AC_REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
WEBHOOK_SIGNING_SECRET=REPLACE_ME
OPENHEAB_PLATFORM_DID=did:op:REPLACE_ME
CRYPTO_RPC_ETH=https://eth-mainnet.g.alchemy.com/v2/REPLACE_ME
CRYPTO_RPC_SOLANA=https://api.mainnet-beta.solana.com
CRYPTO_RPC_BITCOIN=https://blockstream.info/api
OPERATOR_ADMIN_TOKEN=GENERATE_ME_RANDOM_STRING
ADMIN_API_TOKEN=GENERATE_ME_RANDOM_STRING
CRON_SECRET=GENERATE_ME_RANDOM_STRING
DEMO_MODE=false
RUN_MIGRATIONS_ON_BOOT=false

# ============================================================================
# BANK ON-CHAIN
# ============================================================================
BANK_CHAIN=base
BANK_RPC_URL=https://mainnet.base.org
RPC_BASE=https://mainnet.base.org
RPC_OPTIMISM=https://mainnet.optimism.io
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_POLYGON=https://polygon-rpc.com
RPC_ETHEREUM=https://eth.llamarpc.com
RPC_SOLANA=https://api.mainnet-beta.solana.com
FEE_SPLITTER_ADDRESS=0x...
PLATFORM_TREASURY_ADDRESS=0x...
BANK_TRANSFER_STUB=false

# ============================================================================
# INFERENCE PROVIDERS (multi-provider router; at least one required for inference)
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
GOOGLE_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
GROQ_API_KEY=
INFERENCE_MARKUP_BPS=1000

# ============================================================================
# EXTENSIONS MARKETPLACE
# ============================================================================
EXTENSIONS_PUBLISHER_BPS=7000

# ============================================================================
# OBSERVABILITY
# ============================================================================
RATE_LIMIT_PER_MIN=600

# ============================================================================
# IDENTITY ANTI-SPAM
# ============================================================================
IDENTITY_SIGNUP_LIMIT_PER_HOUR=10
HCAPTCHA_SECRET=

# ============================================================================
# OAUTH BRIDGE (set per provider when needed)
# ============================================================================
OAUTH_SLACK_CLIENT_ID=
OAUTH_SLACK_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ============================================================================
# EMAIL GATEWAY
# ============================================================================
EMAIL_DOMAIN=openheab.com
EMAIL_DID_SUBDOMAIN=inbox.openheab.com
EMAIL_GATEWAY_URL=
EMAIL_GATEWAY_SECRET=

# ============================================================================
# STORAGE
# ============================================================================
STORAGE_DRIVER=postgres
STORAGE_QUOTA_BYTES=1073741824
STORAGE_MAX_BLOB_BYTES=10485760
STORAGE_SIGNING_KEY=
