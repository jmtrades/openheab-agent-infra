# Supabase configuration (optional — app works in standalone mode without these)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# When set to "true", the app uses Supabase for persistence.
# When unset or "false", the app runs in standalone mode with localStorage.
NEXT_PUBLIC_USE_SUPABASE=false
